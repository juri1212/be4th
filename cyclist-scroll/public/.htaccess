# be4th.com is served by Apache. Unknown paths get the prerendered 404 page.
ErrorDocument 404 /404.html

# File names in /assets contain a content hash, so they can be cached forever.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# One canonical host: https://be4th.com. Duplicate hosts split ranking signals.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://be4th.com%{REQUEST_URI} [R=301,L]
</IfModule>
